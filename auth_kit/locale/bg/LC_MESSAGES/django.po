msgstr "е активен"

#: auth_kit/mfa/models.py:247
msgid "Whether this method is active and can be used"
msgstr "Дали този метод е активен и може да се използва"

#: auth_kit/mfa/models.py:250
msgid "backup codes"
msgstr "резервни кодове"

#: auth_kit/mfa/models.py:253
msgid "JSON field storing backup codes for account recovery"
msgstr "JSON поле, съхраняващо резервни кодове за възстановяване на акаунта"

