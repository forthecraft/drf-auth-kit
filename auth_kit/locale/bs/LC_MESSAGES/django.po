msgid "secret"
msgstr "tajna"

#: auth_kit/mfa/models.py:237
msgid "TOTP secret key for generating verification codes"
msgstr "TOTP tajni ključ za generiranje verifikacijskih kodova"

#: auth_kit/mfa/models.py:240
msgid "is primary"
msgstr "je primarno"

#: auth_kit/mfa/models.py:242
msgid "Whether this is the user's primary MFA method"
msgstr "Da li je ovo korisnikova primarna MFA metoda"

#: auth_kit/mfa/models.py:245
msgid "is active"
msgstr "je aktivno"

#: auth_kit/mfa/models.py:247
msgid "Whether this method is active and can be used"
msgstr "Da li je ova metoda aktivna i može se koristiti"

#: auth_kit/mfa/models.py:250
msgid "backup codes"
msgstr "rezervni kodovi"

#: auth_kit/mfa/models.py:253
msgid "JSON field storing backup codes for account recovery"
msgstr "JSON polje koje čuva rezervne kodove za oporavak računa"

#: auth_kit/mfa/models.py:259
msgid "MFA Method"
msgstr "MFA metoda"

#: auth_kit/mfa/models.py:260
msgid "MFA Methods"
msgstr "MFA metode"

