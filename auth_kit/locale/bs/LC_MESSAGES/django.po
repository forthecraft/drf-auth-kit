msgstr "Nije moguće deaktivirati primarnu MFA metodu"

#: auth_kit/mfa/serializers/mfa.py:237 auth_kit/mfa/serializers/mfa.py:381
msgid "Invalid OTP code"
msgstr "Nevažeći OTP kod"

#: auth_kit/mfa/serializers/mfa.py:246
msgid "Deactivated MFA method"
msgstr "Deaktivirana MFA metoda"

#: auth_kit/mfa/serializers/mfa.py:304
msgid "Invalid primary method code"
msgstr "Nevažeći kod primarne metode"

#: auth_kit/mfa/serializers/mfa.py:317
msgid "Updated primary MFA method"
msgstr "Ažurirana primarna MFA metoda"

#: auth_kit/mfa/serializers/mfa.py:370
