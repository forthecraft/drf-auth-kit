#: auth_kit/api_descriptions.py:29
msgid ""
"Returns user details along with JWT access and refresh tokens with "
"expiration times."
msgstr ""
"جزئیات کاربر همراه با توکن‌های دسترسی و تازه‌سازی JWT با زمان انقضا "
"برگردانده می‌شود."

#: auth_kit/api_descriptions.py:33
msgid ""
"Returns user details along with a DRF authentication token for API access."
msgstr ""
"جزئیات کاربر همراه با توکن احراز هویت DRF برای دسترسی به API برگردانده "
"می‌شود."

#: auth_kit/api_descriptions.py:36
msgid "Returns user details along with custom authentication tokens."
msgstr "جزئیات کاربر همراه با توکن‌های احراز هویت سفارشی برگردانده می‌شود."

#: auth_kit/api_descriptions.py:42
msgid "JWT access and refresh tokens"
msgstr "توکن‌های دسترسی و تازه‌سازی JWT"

#: auth_kit/api_descriptions.py:44
msgid "DRF authentication token"
msgstr "توکن احراز هویت DRF"

#: auth_kit/api_descriptions.py:46
msgid "custom authentication tokens"
msgstr "توکن‌های احراز هویت سفارشی"

#: auth_kit/api_descriptions.py:53
msgid "Authentication cookies are set automatically for secure token storage."
msgstr ""
"کوکی‌های احراز هویت به طور خودکار برای ذخیره امن توکن‌ها تنظیم می‌شوند."

#: auth_kit/api_descriptions.py:61
msgid "Blacklists JWT refresh tokens to prevent further use."
msgstr ""
"توکن‌های تازه‌سازی JWT را در لیست سیاه قرار می‌دهد تا از استفاده مجدد "
"جلوگیری شود."

#: auth_kit/api_descriptions.py:63
msgid "Deletes the DRF authentication token from the database."
msgstr "توکن احراز هویت DRF را از پایگاه داده حذف می‌کند."

#: auth_kit/api_descriptions.py:65
msgid "Invalidates custom authentication tokens."
msgstr "توکن‌های احراز هویت سفارشی را باطل می‌کند."

#: auth_kit/api_descriptions.py:71
msgid "Clears authentication cookies from the browser."
msgstr "کوکی‌های احراز هویت را از مرورگر پاک می‌کند."

#: auth_kit/api_descriptions.py:77
msgid "Authenticate with username/email and password to obtain access tokens."
msgstr ""
"احراز هویت با نام کاربری/ایمیل و کلمه عبور برای دریافت توکن‌های دسترسی."

#: auth_kit/api_descriptions.py:89
msgid "Logout user and invalidate authentication tokens."
msgstr "خروج کاربر و باطل کردن توکن‌های احراز هویت."

#: auth_kit/api_descriptions.py:93
msgid ""
"Requires authentication to ensure only valid sessions can be logged out."
msgstr "احراز هویت مورد نیاز است تا تنها جلسات معتبر بتوانند خارج شوند."

#: auth_kit/api_descriptions.py:104
msgid "Generate new JWT access tokens using refresh tokens."
msgstr "تولید توکن‌های دسترسی JWT جدید با استفاده از توکن‌های تازه‌سازی."

#: auth_kit/api_descriptions.py:108
msgid ""
"Refresh tokens can be provided in request data or extracted automatically "
"from HTTP cookies."
msgstr ""
"توکن‌های تازه‌سازی می‌توانند در داده‌های درخواست ارائه شوند یا به طور خودکار"
" از کوکی‌های HTTP استخراج شوند."

#: auth_kit/api_descriptions.py:110 auth_kit/api_descriptions.py:120
msgid "Returns new access tokens with updated expiration times."
msgstr "توکن‌های دسترسی جدید با زمان انقضای به‌روزرسانی شده برگردانده می‌شود."

#: auth_kit/api_descriptions.py:112
msgid "New tokens are automatically set in HTTP cookies for secure storage."
msgstr ""
"توکن‌های جدید به طور خودکار در کوکی‌های HTTP برای ذخیره امن تنظیم می‌شوند."

#: auth_kit/api_descriptions.py:119
msgid "Refresh tokens must be provided in the request data."
msgstr "توکن‌های تازه‌سازی باید در داده‌های درخواست ارائه شوند."

#: auth_kit/api_descriptions.py:127
msgid "Register a new user account."
msgstr "ثبت نام حساب کاربری جدید."

#: auth_kit/api_descriptions.py:134
msgid ""
"Users must verify their email address before the account is fully activated."
msgstr "کاربران باید آدرس ایمیل خود را قبل از فعال‌سازی کامل حساب تأیید کنند."

#: auth_kit/api_descriptions.py:143
msgid ""
"Send password reset instructions to the provided email address. If the email"
" is registered, a secure reset link will be sent. The link expires after a "
"limited time for security."
msgstr ""
"ارسال دستورالعمل بازنشانی کلمه عبور به آدرس ایمیل ارائه شده. اگر ایمیل ثبت "
"شده باشد، یک لینک امن بازنشانی ارسال خواهد شد. این لینک پس از مدت محدود برای"
" امنیت منقضی می‌شود."

#: auth_kit/api_descriptions.py:149
msgid ""
"Complete the password reset process using the token from the reset email. "
"Requires the UID and token from the email along with the new password. The "
"token is single-use and expires for security."
msgstr ""
"تکمیل فرآیند بازنشانی کلمه عبور با استفاده از توکن ایمیل بازنشانی. شناسه "
"کاربری و توکن از ایمیل همراه با کلمه عبور جدید مورد نیاز است. توکن یک‌بار "
"مصرف و برای امنیت منقضی می‌شود."

#: auth_kit/api_descriptions.py:155
msgid "Change the current user's password. Requires authentication. "
msgstr "تغییر کلمه عبور کاربر فعلی. احراز هویت مورد نیاز است. "

#: auth_kit/api_descriptions.py:159
msgid ""
"Confirm email address using the verification key sent via email. This "
"activates the user account and allows login access."
msgstr ""
"تأیید آدرس ایمیل با استفاده از کلید تأیید ارسال شده از طریق ایمیل. این عمل "
"حساب کاربری را فعال می‌کند و دسترسی ورود را امکان‌پذیر می‌سازد."

#: auth_kit/api_descriptions.py:164
msgid ""
"Send a new email verification message to unverified email addresses. Only "
"works for email addresses that are registered but not yet verified."
msgstr ""
"ارسال پیام تأیید ایمیل جدید به آدرس‌های ایمیل تأیید نشده. فقط برای آدرس‌های "
"ایمیل که ثبت شده اما هنوز تأیید نشده‌اند کار می‌کند."

#: auth_kit/api_descriptions.py:169
msgid ""
"Retrieve the authenticated user's profile information including username, "
"email, first name, and last name. Password fields are excluded."
msgstr ""
"بازیابی اطلاعات پروفایل کاربر احراز هویت شده شامل نام کاربری، ایمیل، نام و "
"نام خانوادگی. فیلدهای کلمه عبور حذف می‌شوند."

#: auth_kit/api_descriptions.py:174
msgid ""
"Update the authenticated user's profile information. Allows modification of "
"username, first name, and last name. Email field is read-only for security."
msgstr ""
"به‌روزرسانی اطلاعات پروفایل کاربر احراز هویت شده. امکان تغییر نام کاربری، "
"نام و نام خانوادگی را فراهم می‌کند. فیلد ایمیل برای امنیت فقط خواندنی است."

#: auth_kit/api_descriptions.py:180
msgid ""
"Partially update the authenticated user's profile information. Only provided"
" fields will be updated. Email field is read-only."
msgstr ""
"به‌روزرسانی جزئی اطلاعات پروفایل کاربر احراز هویت شده. فقط فیلدهای ارائه شده"
" به‌روزرسانی خواهند شد. فیلد ایمیل فقط خواندنی است."

#: auth_kit/forms.py:111
msgid "The email address is not assigned to any user account."
msgstr "آدرس ایمیل به هیچ حساب کاربری اختصاص داده نشده است."

#: auth_kit/mfa/exceptions.py:27
msgid "Requested MFA method does not exist."
msgstr "روش MFA درخواست شده وجود ندارد."

#: auth_kit/mfa/handlers/email.py:29
msgid "Email message with MFA code has been sent."
msgstr "پیام ایمیل همراه با کد MFA ارسال شده است."

#: auth_kit/mfa/handlers/webauthn.py:39
msgid "Registration options for navigator.credentials.create()"
msgstr "گزینه‌های ثبت‌نام برای navigator.credentials.create()"

#: auth_kit/mfa/handlers/webauthn.py:57
msgid "Security Key / Passkey"
msgstr "کلید امنیتی / کلید عبور"

#: auth_kit/mfa/mfa_api_descriptions.py:29
#, python-brace-format
msgid "MFA code expires in {} seconds."
msgstr "کد MFA در {} ثانیه منقضی می‌شود."

#: auth_kit/mfa/mfa_api_descriptions.py:37
msgid ""
"First step of MFA-enabled authentication. Validates credentials and "
"initiates MFA flow."
msgstr ""
"مرحله اول احراز هویت با MFA فعال. اعتبارسنجی اعتبارنامه‌ها و شروع جریان MFA."

#: auth_kit/mfa/mfa_api_descriptions.py:42
#, python-brace-format
msgid ""
"Returns ephemeral token for MFA verification or complete {} if MFA is "
"disabled."
msgstr ""
"توکن موقت برای تأیید MFA یا {} کامل در صورت غیرفعال بودن MFA برگردانده "
"می‌شود."

#: auth_kit/mfa/mfa_api_descriptions.py:54
msgid ""
"Complete MFA authentication using verification code and ephemeral token."
msgstr "تکمیل احراز هویت MFA با استفاده از کد تأیید و توکن موقت."

#: auth_kit/mfa/mfa_api_descriptions.py:59
msgid "Supports both TOTP codes and backup codes for verification."
msgstr "از کدهای TOTP و کدهای پشتیبان برای تأیید پشتیبانی می‌کند."

#: auth_kit/mfa/mfa_api_descriptions.py:71
msgid "Switch to a different MFA method during authentication flow."
msgstr "تغییر به روش MFA متفاوت در طول جریان احراز هویت."

#: auth_kit/mfa/mfa_api_descriptions.py:73
msgid "Requires valid ephemeral token from first step authentication."
msgstr "توکن موقت معتبر از مرحله اول احراز هویت مورد نیاز است."

#: auth_kit/mfa/mfa_api_descriptions.py:76
#: auth_kit/mfa/mfa_api_descriptions.py:92
#, python-brace-format
msgid "New ephemeral token expires in {} seconds."
msgstr "توکن موقت جدید در {} ثانیه منقضی می‌شود."

#: auth_kit/mfa/mfa_api_descriptions.py:85
msgid "Resend MFA verification code using existing ephemeral token."
msgstr "ارسال مجدد کد تأیید MFA با استفاده از توکن موقت موجود."

#: auth_kit/mfa/mfa_api_descriptions.py:88
msgid "Only applicable for methods that require code dispatch (e.g., email)."
msgstr ""
"فقط برای روش‌هایی که نیاز به ارسال کد دارند (مثلاً ایمیل) قابل اجرا است."

#: auth_kit/mfa/mfa_api_descriptions.py:102
msgid ""
"Get a login challenge for the pending MFA method using an existing ephemeral"
" token."
msgstr "دریافت چالش ورود برای روش MFA معلق با استفاده از یک توکن موقت موجود."

#: auth_kit/mfa/mfa_api_descriptions.py:107
msgid ""
"Only applicable for challenge-response methods (e.g., passkeys). Other "
"methods return an empty object."
msgstr ""
"فقط برای روش‌های چالش-پاسخ (مانند کلیدهای عبور) قابل استفاده است. سایر "
"روش‌ها یک شیء خالی برمی‌گردانند."

#: auth_kit/mfa/mfa_api_descriptions.py:116
msgid ""
"List all available MFA methods with their setup and activation status. Shows"
" which methods are configured, active, and set as primary."
msgstr ""
"فهرست تمام روش‌های MFA موجود با وضعیت راه‌اندازی و فعال‌سازی آن‌ها. نشان "
"می‌دهد کدام روش‌ها پیکربندی شده، فعال و به عنوان اصلی تنظیم شده‌اند."

#: auth_kit/mfa/mfa_api_descriptions.py:121
msgid ""
"Initialize a new MFA method setup. Creates the method with backup codes and "
"returns setup instructions (e.g., QR code for authenticator apps). Method "
"must be confirmed before activation."
msgstr ""
"راه‌اندازی یک روش MFA جدید. روش را با کدهای پشتیبان ایجاد می‌کند و "
"دستورالعمل راه‌اندازی (مثلاً QR کد برای برنامه‌های احراز هویت) برمی‌گرداند. "
"روش باید قبل از فعال‌سازی تأیید شود."

#: auth_kit/mfa/mfa_api_descriptions.py:127
msgid ""
"Confirm and activate a newly created MFA method using verification code. "
"Automatically sets as primary method if no other primary method exists. "
"Required before the method can be used for authentication."
msgstr ""
"تأیید و فعال‌سازی روش MFA تازه ایجاد شده با استفاده از کد تأیید. به طور "
"خودکار به عنوان روش اصلی تنظیم می‌شود اگر هیچ روش اصلی دیگری وجود نداشته "
"باشد. قبل از استفاده روش برای احراز هویت ضروری است."

#: auth_kit/mfa/mfa_api_descriptions.py:136
msgid ""
"Deactivate an active MFA method. Requires verification code from the method "
"itself."
msgstr "یک روش MFA فعال را غیرفعال می‌کند. نیازمند کد تأیید از همان روش است."

#: auth_kit/mfa/mfa_api_descriptions.py:142
msgid "Deactivation is disabled by configuration."
msgstr "غیرفعال‌سازی توسط پیکربندی غیرمجاز شده است."

#: auth_kit/mfa/mfa_api_descriptions.py:146
msgid "Cannot deactivate primary methods."
msgstr "روش‌های اصلی را نمی‌توان غیرفعال کرد."

#: auth_kit/mfa/mfa_api_descriptions.py:151
msgid "Deactivating the primary method promotes another active method."
msgstr "غیرفعال کردن روش اصلی، روش فعال دیگری را ارتقا می‌دهد."

#: auth_kit/mfa/mfa_api_descriptions.py:158
msgid ""
"Set an active MFA method as the primary authentication method. Primary "
"method is used by default during login flow."
msgstr ""
"تنظیم روش MFA فعال به عنوان روش احراز هویت اصلی. روش اصلی به طور پیش‌فرض در "
"جریان ورود استفاده می‌شود."

#: auth_kit/mfa/mfa_api_descriptions.py:162
msgid "Only one method can be primary at a time."
msgstr "فقط یک روش می‌تواند در یک زمان اصلی باشد."

#: auth_kit/mfa/mfa_api_descriptions.py:165
msgid "Requires verification code from current primary method."
msgstr "کد تأیید از روش اصلی فعلی مورد نیاز است."

#: auth_kit/mfa/mfa_api_descriptions.py:172
msgid ""
"Send verification code for methods that support code dispatch. Useful for "
"testing method configuration or manual code requests."
msgstr ""
"ارسال کد تأیید برای روش‌هایی که از ارسال کد پشتیبانی می‌کنند. برای آزمایش "
"پیکربندی روش یا درخواست‌های دستی کد مفید است."

#: auth_kit/mfa/mfa_api_descriptions.py:178
msgid ""
"Get a challenge to verify one of your own MFA methods. WebAuthn returns "
"ceremony options to sign; code-based methods return an empty payload."
msgstr ""
"یک چالش برای تأیید یکی از روش‌های MFA خود دریافت کنید. WebAuthn گزینه‌های "
"مراسم برای امضا را برمی‌گرداند؛ روش‌های مبتنی بر کد یک payload خالی "
"برمی‌گردانند."

#: auth_kit/mfa/mfa_api_descriptions.py:186
msgid "Permanently delete an MFA method."
msgstr "حذف دائمی روش MFA."

#: auth_kit/mfa/mfa_api_descriptions.py:187
msgid "This action cannot be undone."
msgstr "این عمل قابل بازگشت نیست."

#: auth_kit/mfa/mfa_api_descriptions.py:192
msgid "Cannot delete active methods."
msgstr "نمی‌توان روش‌های فعال را حذف کرد."

#: auth_kit/mfa/mfa_api_descriptions.py:195
msgid "Cannot delete primary methods."
msgstr "نمی‌توان روش‌های اصلی را حذف کرد."

#: auth_kit/mfa/mfa_api_descriptions.py:198
msgid "Requires verification code for active methods."
msgstr "کد تأیید برای روش‌های فعال مورد نیاز است."

#: auth_kit/mfa/models.py:225 auth_kit/webauthn/models/credential.py:134
msgid "user"
msgstr "کاربر"

#: auth_kit/mfa/models.py:227
msgid "User who owns this MFA method"
msgstr "کاربری که مالک این روش MFA است"

#: auth_kit/mfa/models.py:230 auth_kit/webauthn/models/credential.py:171
msgid "name"
msgstr "نام"

#: auth_kit/mfa/models.py:232
msgid "MFA method name (e.g., 'app', 'email')"
msgstr "نام روش MFA (مثلاً 'app', 'email')"

#: auth_kit/mfa/models.py:235
msgid "secret"
msgstr "رمز"

#: auth_kit/mfa/models.py:237
msgid "TOTP secret key for generating verification codes"
msgstr "کلید محرمانه TOTP برای تولید کدهای تأیید"

#: auth_kit/mfa/models.py:240
msgid "is primary"
msgstr "اصلی است"

#: auth_kit/mfa/models.py:242
msgid "Whether this is the user's primary MFA method"
msgstr "آیا این روش MFA اصلی کاربر است"

#: auth_kit/mfa/models.py:245
msgid "is active"
msgstr "فعال است"

#: auth_kit/mfa/models.py:247
msgid "Whether this method is active and can be used"
msgstr "آیا این روش فعال است و قابل استفاده است"

#: auth_kit/mfa/models.py:250
msgid "backup codes"
msgstr "کدهای پشتیبان"

#: auth_kit/mfa/models.py:253
msgid "JSON field storing backup codes for account recovery"
msgstr "فیلد JSON برای ذخیره کدهای پشتیبان برای بازیابی حساب"

#: auth_kit/mfa/models.py:259
msgid "MFA Method"
msgstr "روش MFA"

#: auth_kit/mfa/models.py:260
msgid "MFA Methods"
msgstr "روش‌های MFA"

#: auth_kit/mfa/serializers/login_factors.py:155
msgid "Invalid code"
msgstr "کد نامعتبر"

#: auth_kit/mfa/serializers/login_factors.py:174
#: auth_kit/mfa/serializers/login_factors.py:228
#: auth_kit/mfa/serializers/login_factors.py:276
#: auth_kit/mfa/serializers/login_factors.py:315
msgid "Invalid token"
msgstr "توکن نامعتبر"

#: auth_kit/mfa/serializers/login_factors.py:232
msgid "Please select a new method"
msgstr "لطفاً روش جدیدی انتخاب کنید"

#: auth_kit/mfa/serializers/mfa.py:109
msgid "This method is already exists"
msgstr "این روش از قبل وجود دارد"

#: auth_kit/mfa/serializers/mfa.py:178
msgid "Invalid verification code"
msgstr "کد تأیید نامعتبر"

#: auth_kit/mfa/serializers/mfa.py:188
msgid "Activated MFA method"
msgstr "روش MFA فعال شد"

#: auth_kit/mfa/serializers/mfa.py:230
msgid "Cannot deactivate active MFA method"
msgstr "روش MFA فعال را نمی‌توان غیرفعال کرد"

#: auth_kit/mfa/serializers/mfa.py:231
msgid "Cannot deactivate primary MFA method"
msgstr "روش MFA اصلی را نمی‌توان غیرفعال کرد"

#: auth_kit/mfa/serializers/mfa.py:237 auth_kit/mfa/serializers/mfa.py:381
msgid "Invalid OTP code"
msgstr "کد OTP نامعتبر"

#: auth_kit/mfa/serializers/mfa.py:246
msgid "Deactivated MFA method"
msgstr "روش MFA غیرفعال شد"

#: auth_kit/mfa/serializers/mfa.py:304
msgid "Invalid primary method code"
msgstr "کد روش اصلی نامعتبر"

#: auth_kit/mfa/serializers/mfa.py:317
msgid "Updated primary MFA method"
msgstr "روش MFA اصلی به‌روزرسانی شد"

#: auth_kit/mfa/serializers/mfa.py:370
msgid "Cannot delete active MFA method"
msgstr "نمی‌توان روش MFA فعال را حذف کرد"

#: auth_kit/mfa/serializers/mfa.py:371
msgid "Cannot delete primary MFA method"
msgstr "نمی‌توان روش MFA اصلی را حذف کرد"

#: auth_kit/mfa/serializers/mfa.py:390
msgid "Method does not exist"
msgstr "روش وجود ندارد"

#: auth_kit/mfa/serializers/mfa.py:392
