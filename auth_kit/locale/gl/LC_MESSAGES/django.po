msgstr ""
"Campo JSON que almacena códigos de respaldo para recuperación de conta"

#: auth_kit/mfa/models.py:259
msgid "MFA Method"
msgstr "Método MFA"

#: auth_kit/mfa/models.py:260
msgid "MFA Methods"
msgstr "Métodos MFA"

