#: auth_kit/mfa/models.py:189
msgid "is active"
msgstr "aktív"

#: auth_kit/mfa/models.py:191
msgid "Whether this method is active and can be used"
msgstr "Hogy ez a módszer aktív-e és használható-e"

#: auth_kit/mfa/models.py:194
msgid "backup codes"
msgstr "biztonsági mentés kódok"

#: auth_kit/mfa/models.py:197
msgid "JSON field storing backup codes for account recovery"
msgstr ""
"JSON mező, amely a fiók helyreállításához szükséges biztonsági kódokat "
"tárolja"

#: auth_kit/mfa/models.py:203
msgid "MFA Method"
msgstr "MFA módszer"

#: auth_kit/mfa/models.py:204
msgid "MFA Methods"
msgstr "MFA módszerek"

