#: auth_kit/api_descriptions.py:29
msgid ""
"Returns user details along with JWT access and refresh tokens with "
"expiration times."
msgstr ""
"Mengembalikan detail pengguna beserta token akses JWT dan token refresh "
"dengan waktu kedaluwarsa."

#: auth_kit/api_descriptions.py:33
msgid ""
"Returns user details along with a DRF authentication token for API access."
msgstr ""
"Mengembalikan detail pengguna beserta token autentikasi DRF untuk akses API."

#: auth_kit/api_descriptions.py:36
msgid "Returns user details along with custom authentication tokens."
msgstr "Mengembalikan detail pengguna beserta token autentikasi kustom."

#: auth_kit/api_descriptions.py:42
msgid "JWT access and refresh tokens"
msgstr "Token akses dan refresh JWT"

#: auth_kit/api_descriptions.py:44
msgid "DRF authentication token"
msgstr "Token autentikasi DRF"

#: auth_kit/api_descriptions.py:46
msgid "custom authentication tokens"
msgstr "token autentikasi kustom"

#: auth_kit/api_descriptions.py:53
msgid "Authentication cookies are set automatically for secure token storage."
msgstr ""
"Cookie autentikasi diatur secara otomatis untuk penyimpanan token yang aman."

#: auth_kit/api_descriptions.py:61
msgid "Blacklists JWT refresh tokens to prevent further use."
msgstr "Memblokir token refresh JWT untuk mencegah penggunaan lebih lanjut."

#: auth_kit/api_descriptions.py:63
msgid "Deletes the DRF authentication token from the database."
msgstr "Menghapus token autentikasi DRF dari basis data."

#: auth_kit/api_descriptions.py:65
msgid "Invalidates custom authentication tokens."
msgstr "Membatalkan token autentikasi kustom."

#: auth_kit/api_descriptions.py:71
msgid "Clears authentication cookies from the browser."
msgstr "Menghapus cookie autentikasi dari browser."

#: auth_kit/api_descriptions.py:77
msgid "Authenticate with username/email and password to obtain access tokens."
msgstr ""
"Melakukan autentikasi dengan nama pengguna/email dan kata sandi untuk "
"mendapatkan token akses."

#: auth_kit/api_descriptions.py:89
msgid "Logout user and invalidate authentication tokens."
msgstr "Mengeluarkan pengguna dan membatalkan token autentikasi."

#: auth_kit/api_descriptions.py:93
msgid ""
"Requires authentication to ensure only valid sessions can be logged out."
msgstr ""
"Memerlukan autentikasi untuk memastikan hanya sesi yang valid yang dapat "
"dikeluarkan."

#: auth_kit/api_descriptions.py:104
msgid "Generate new JWT access tokens using refresh tokens."
msgstr "Menghasilkan token akses JWT baru menggunakan token refresh."

#: auth_kit/api_descriptions.py:108
msgid ""
"Refresh tokens can be provided in request data or extracted automatically "
"from HTTP cookies."
msgstr ""
"Token refresh dapat disediakan dalam data permintaan atau diekstrak secara "
"otomatis dari cookie HTTP."

#: auth_kit/api_descriptions.py:110 auth_kit/api_descriptions.py:120
msgid "Returns new access tokens with updated expiration times."
msgstr ""
"Mengembalikan token akses baru dengan waktu kedaluwarsa yang diperbarui."

#: auth_kit/api_descriptions.py:112
msgid "New tokens are automatically set in HTTP cookies for secure storage."
msgstr ""
"Token baru secara otomatis diatur dalam cookie HTTP untuk penyimpanan yang "
"aman."

#: auth_kit/api_descriptions.py:119
msgid "Refresh tokens must be provided in the request data."
msgstr "Token refresh harus disediakan dalam data permintaan."

#: auth_kit/api_descriptions.py:127
msgid "Register a new user account."
msgstr "Mendaftarkan akun pengguna baru."

#: auth_kit/api_descriptions.py:134
msgid ""
"Users must verify their email address before the account is fully activated."
msgstr ""
"Pengguna harus memverifikasi alamat email mereka sebelum akun sepenuhnya "
"diaktifkan."

#: auth_kit/api_descriptions.py:143
msgid ""
"Send password reset instructions to the provided email address. If the email"
" is registered, a secure reset link will be sent. The link expires after a "
"limited time for security."
msgstr ""
"Mengirim instruksi reset kata sandi ke alamat email yang diberikan. Jika "
"email terdaftar, tautan reset yang aman akan dikirim. Tautan akan "
"kedaluwarsa setelah waktu terbatas untuk keamanan."

#: auth_kit/api_descriptions.py:149
msgid ""
"Complete the password reset process using the token from the reset email. "
"Requires the UID and token from the email along with the new password. The "
"token is single-use and expires for security."
msgstr ""
"Menyelesaikan proses reset kata sandi menggunakan token dari email reset. "
"Memerlukan UID dan token dari email beserta kata sandi baru. Token hanya "
"dapat digunakan sekali dan akan kedaluwarsa untuk keamanan."

#: auth_kit/api_descriptions.py:155
msgid "Change the current user's password. Requires authentication. "
msgstr "Mengubah kata sandi pengguna saat ini. Memerlukan autentikasi. "

#: auth_kit/api_descriptions.py:159
msgid ""
"Confirm email address using the verification key sent via email. This "
"activates the user account and allows login access."
msgstr ""
"Mengonfirmasi alamat email menggunakan kunci verifikasi yang dikirim melalui"
" email. Ini mengaktifkan akun pengguna dan memungkinkan akses masuk."

#: auth_kit/api_descriptions.py:164
msgid ""
"Send a new email verification message to unverified email addresses. Only "
"works for email addresses that are registered but not yet verified."
msgstr ""
"Mengirim pesan verifikasi email baru ke alamat email yang belum "
"diverifikasi. Hanya berfungsi untuk alamat email yang terdaftar tetapi belum"
" diverifikasi."

#: auth_kit/api_descriptions.py:169
msgid ""
"Retrieve the authenticated user's profile information including username, "
"email, first name, and last name. Password fields are excluded."
msgstr ""
"Mengambil informasi profil pengguna yang terautentikasi termasuk nama "
"pengguna, email, nama depan, dan nama belakang. Bidang kata sandi "
"dikecualikan."

#: auth_kit/api_descriptions.py:174
msgid ""
"Update the authenticated user's profile information. Allows modification of "
"username, first name, and last name. Email field is read-only for security."
msgstr ""
"Memperbarui informasi profil pengguna yang terautentikasi. Memungkinkan "
"modifikasi nama pengguna, nama depan, dan nama belakang. Bidang email "
"bersifat baca-saja untuk keamanan."

#: auth_kit/api_descriptions.py:180
msgid ""
"Partially update the authenticated user's profile information. Only provided"
" fields will be updated. Email field is read-only."
msgstr ""
"Memperbarui sebagian informasi profil pengguna yang terautentikasi. Hanya "
"bidang yang disediakan yang akan diperbarui. Bidang email bersifat baca-"
"saja."

#: auth_kit/forms.py:111
msgid "The email address is not assigned to any user account."
msgstr "Alamat email tidak ditetapkan ke akun pengguna mana pun."

#: auth_kit/mfa/exceptions.py:27
msgid "Requested MFA method does not exist."
msgstr "Metode MFA yang diminta tidak ada."

#: auth_kit/mfa/handlers/email.py:29
msgid "Email message with MFA code has been sent."
msgstr "Pesan email dengan kode MFA telah dikirim."

#: auth_kit/mfa/handlers/webauthn.py:39
msgid "Registration options for navigator.credentials.create()"
msgstr "Opsi pendaftaran untuk navigator.credentials.create()"

#: auth_kit/mfa/handlers/webauthn.py:57
msgid "Security Key / Passkey"
msgstr "Kunci Keamanan / Kunci Sandi"

#: auth_kit/mfa/mfa_api_descriptions.py:29
#, python-brace-format
msgid "MFA code expires in {} seconds."
msgstr "Kode MFA akan kedaluwarsa dalam {} detik."

#: auth_kit/mfa/mfa_api_descriptions.py:37
msgid ""
"First step of MFA-enabled authentication. Validates credentials and "
"initiates MFA flow."
msgstr ""
"Langkah pertama autentikasi yang diaktifkan MFA. Memvalidasi kredensial dan "
"memulai alur MFA."

#: auth_kit/mfa/mfa_api_descriptions.py:42
#, python-brace-format
msgid ""
"Returns ephemeral token for MFA verification or complete {} if MFA is "
"disabled."
msgstr ""
"Mengembalikan token sementara untuk verifikasi MFA atau {} lengkap jika MFA "
"dinonaktifkan."

#: auth_kit/mfa/mfa_api_descriptions.py:54
msgid ""
"Complete MFA authentication using verification code and ephemeral token."
msgstr ""
"Menyelesaikan autentikasi MFA menggunakan kode verifikasi dan token "
"sementara."

#: auth_kit/mfa/mfa_api_descriptions.py:59
msgid "Supports both TOTP codes and backup codes for verification."
msgstr "Mendukung kode TOTP dan kode cadangan untuk verifikasi."

#: auth_kit/mfa/mfa_api_descriptions.py:71
msgid "Switch to a different MFA method during authentication flow."
msgstr "Beralih ke metode MFA yang berbeda selama alur autentikasi."

#: auth_kit/mfa/mfa_api_descriptions.py:73
msgid "Requires valid ephemeral token from first step authentication."
msgstr ""
"Memerlukan token sementara yang valid dari autentikasi langkah pertama."

#: auth_kit/mfa/mfa_api_descriptions.py:76
#: auth_kit/mfa/mfa_api_descriptions.py:92
#, python-brace-format
msgid "New ephemeral token expires in {} seconds."
msgstr "Token sementara baru akan kedaluwarsa dalam {} detik."

#: auth_kit/mfa/mfa_api_descriptions.py:85
msgid "Resend MFA verification code using existing ephemeral token."
msgstr ""
"Mengirim ulang kode verifikasi MFA menggunakan token sementara yang ada."

#: auth_kit/mfa/mfa_api_descriptions.py:88
msgid "Only applicable for methods that require code dispatch (e.g., email)."
msgstr ""
"Hanya berlaku untuk metode yang memerlukan pengiriman kode (misalnya, "
"email)."

#: auth_kit/mfa/mfa_api_descriptions.py:102
msgid ""
"Get a login challenge for the pending MFA method using an existing ephemeral"
" token."
msgstr ""
"Dapatkan tantangan masuk untuk metode MFA yang tertunda menggunakan token "
"sementara yang ada."

#: auth_kit/mfa/mfa_api_descriptions.py:107
msgid ""
"Only applicable for challenge-response methods (e.g., passkeys). Other "
"methods return an empty object."
msgstr ""
"Hanya berlaku untuk metode tantangan-respons (misalnya, kunci sandi). Metode"
" lain mengembalikan objek kosong."

#: auth_kit/mfa/mfa_api_descriptions.py:116
msgid ""
"List all available MFA methods with their setup and activation status. Shows"
" which methods are configured, active, and set as primary."
msgstr ""
"Membuat daftar semua metode MFA yang tersedia dengan status pengaturan dan "
"aktivasi mereka. Menunjukkan metode mana yang dikonfigurasi, aktif, dan "
"ditetapkan sebagai utama."

#: auth_kit/mfa/mfa_api_descriptions.py:121
msgid ""
"Initialize a new MFA method setup. Creates the method with backup codes and "
"returns setup instructions (e.g., QR code for authenticator apps). Method "
"must be confirmed before activation."
msgstr ""
"Menginisialisasi pengaturan metode MFA baru. Membuat metode dengan kode "
"cadangan dan mengembalikan instruksi pengaturan (misalnya, kode QR untuk "
"aplikasi autentikator). Metode harus dikonfirmasi sebelum aktivasi."

#: auth_kit/mfa/mfa_api_descriptions.py:127
msgid ""
"Confirm and activate a newly created MFA method using verification code. "
"Automatically sets as primary method if no other primary method exists. "
"Required before the method can be used for authentication."
msgstr ""
"Mengonfirmasi dan mengaktifkan metode MFA yang baru dibuat menggunakan kode "
"verifikasi. Secara otomatis menetapkan sebagai metode utama jika tidak ada "
"metode utama lain yang ada. Diperlukan sebelum metode dapat digunakan untuk "
"autentikasi."

#: auth_kit/mfa/mfa_api_descriptions.py:136
msgid ""
"Deactivate an active MFA method. Requires verification code from the method "
"itself."
msgstr ""
"Menonaktifkan metode MFA yang aktif. Memerlukan kode verifikasi dari metode "
"itu sendiri."

#: auth_kit/mfa/mfa_api_descriptions.py:142
msgid "Deactivation is disabled by configuration."
msgstr "Penonaktifan dinonaktifkan oleh konfigurasi."

#: auth_kit/mfa/mfa_api_descriptions.py:146
msgid "Cannot deactivate primary methods."
msgstr "Metode utama tidak dapat dinonaktifkan."

#: auth_kit/mfa/mfa_api_descriptions.py:151
msgid "Deactivating the primary method promotes another active method."
msgstr "Menonaktifkan metode utama akan mempromosikan metode aktif lainnya."

#: auth_kit/mfa/mfa_api_descriptions.py:158
msgid ""
"Set an active MFA method as the primary authentication method. Primary "
"method is used by default during login flow."
msgstr ""
"Menetapkan metode MFA yang aktif sebagai metode autentikasi utama. Metode "
"utama digunakan secara default selama alur masuk."

#: auth_kit/mfa/mfa_api_descriptions.py:162
msgid "Only one method can be primary at a time."
msgstr "Hanya satu metode yang dapat menjadi utama pada satu waktu."

#: auth_kit/mfa/mfa_api_descriptions.py:165
msgid "Requires verification code from current primary method."
msgstr "Memerlukan kode verifikasi dari metode utama saat ini."

#: auth_kit/mfa/mfa_api_descriptions.py:172
msgid ""
"Send verification code for methods that support code dispatch. Useful for "
"testing method configuration or manual code requests."
msgstr ""
"Mengirim kode verifikasi untuk metode yang mendukung pengiriman kode. "
"Berguna untuk menguji konfigurasi metode atau permintaan kode manual."

#: auth_kit/mfa/mfa_api_descriptions.py:178
msgid ""
"Get a challenge to verify one of your own MFA methods. WebAuthn returns "
"ceremony options to sign; code-based methods return an empty payload."
msgstr ""
"Dapatkan tantangan untuk memverifikasi salah satu metode MFA Anda sendiri. "
"WebAuthn mengembalikan opsi ceremony untuk ditandatangani; metode berbasis "
"kode mengembalikan muatan kosong."

#: auth_kit/mfa/mfa_api_descriptions.py:186
msgid "Permanently delete an MFA method."
msgstr "Menghapus metode MFA secara permanen."

#: auth_kit/mfa/mfa_api_descriptions.py:187
msgid "This action cannot be undone."
msgstr "Tindakan ini tidak dapat dibatalkan."

#: auth_kit/mfa/mfa_api_descriptions.py:192
msgid "Cannot delete active methods."
msgstr "Tidak dapat menghapus metode yang aktif."

#: auth_kit/mfa/mfa_api_descriptions.py:195
msgid "Cannot delete primary methods."
msgstr "Tidak dapat menghapus metode utama."

#: auth_kit/mfa/mfa_api_descriptions.py:198
msgid "Requires verification code for active methods."
msgstr "Memerlukan kode verifikasi untuk metode yang aktif."

#: auth_kit/mfa/models.py:225 auth_kit/webauthn/models/credential.py:134
