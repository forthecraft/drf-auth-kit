msgstr "Apakah metode ini aktif dan dapat digunakan"

#: auth_kit/mfa/models.py:250
msgid "backup codes"
msgstr "kode cadangan"

#: auth_kit/mfa/models.py:253
msgid "JSON field storing backup codes for account recovery"
msgstr "Bidang JSON yang menyimpan kode cadangan untuk pemulihan akun"

#: auth_kit/mfa/models.py:259
msgid "MFA Method"
msgstr "Metode MFA"

#: auth_kit/mfa/models.py:260
msgid "MFA Methods"
msgstr "Metode MFA"

