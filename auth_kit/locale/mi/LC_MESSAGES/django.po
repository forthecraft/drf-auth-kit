msgstr "Waehere muhu"

#: auth_kit/mfa/serializers/login_factors.py:172
#: auth_kit/mfa/serializers/login_factors.py:226
#: auth_kit/mfa/serializers/login_factors.py:274
#: auth_kit/mfa/serializers/login_factors.py:313
msgid "Invalid token"
msgstr "Tohu muhu"

#: auth_kit/mfa/serializers/login_factors.py:230
msgid "Please select a new method"
msgstr "Koa kōwhiri he tikanga hou"

#: auth_kit/mfa/serializers/mfa.py:76
msgid "This method is already exists"
msgstr "Kua rēhia tenei tikanga"

#: auth_kit/mfa/serializers/mfa.py:145
msgid "Invalid verification code"
msgstr "He hee te waehere manatoko"

#: auth_kit/mfa/serializers/mfa.py:155
msgid "Activated MFA method"
msgstr "Tikanga MFA whakahohea"

#: auth_kit/mfa/serializers/mfa.py:194
msgid "You can only deactivate non-primary MFA method."
msgstr "Ka taea e koe te whakakorekore tikanga MFA kore-matua anake."

#: auth_kit/mfa/serializers/mfa.py:200 auth_kit/mfa/serializers/mfa.py:345
msgid "Invalid OTP code"
msgstr "Waehere OTP muhu"

#: auth_kit/mfa/serializers/mfa.py:206
msgid "Deactivated MFA method"
msgstr "Tikanga MFA whakakorekore"

#: auth_kit/mfa/serializers/mfa.py:262
msgid "Invalid primary method code"
msgstr "Waehere tikanga matua muhu"

#: auth_kit/mfa/serializers/mfa.py:275
msgid "Updated primary MFA method"
msgstr "Tikanga MFA matua whakahoutia"

#: auth_kit/mfa/serializers/mfa.py:330
msgid "Cannot delete active MFA method"
msgstr "Kaore e taea te muku tikanga MFA hohe"

#: auth_kit/mfa/serializers/mfa.py:336
msgid "Cannot delete primary MFA method"
msgstr "Kaore e taea te muku tikanga MFA matua"

#: auth_kit/mfa/serializers/mfa.py:350
msgid "Method does not exist"
msgstr "Kaore te tikanga i rēhia"

#: auth_kit/mfa/serializers/mfa.py:352
msgid "Deleted MFA method"
msgstr "Tikanga MFA mukua"

#: auth_kit/mfa/serializers/mfa.py:392
msgid "MFA code sent"
msgstr "Waehere MFA tukuna"

#: auth_kit/passwordless/handlers/email_link.py:43
msgid "Email Magic Link"
msgstr "Hononga Makutu Imeera"

#: auth_kit/passwordless/handlers/email_link.py:82
#: auth_kit/passwordless/handlers/email_link.py:115
msgid "A login link has been sent."
msgstr "Kua tukuna he hononga takiuru."

#: auth_kit/passwordless/handlers/webauthn.py:39
msgid "Passkey / Security Key"
msgstr "Passkey / Taviri Haumarutanga"

#: auth_kit/passwordless/passwordless_api_descriptions.py:42
#, python-brace-format
msgid ""
"Initiate passwordless authentication via {}. This is the first step of the "
"passwordless login flow."
msgstr ""
"Timata i te whakamotuhēhēnga kore kupuhipa ma {}. Ko tenei te hikoinga "
"tuatahi o te ara takiuru kore kupuhipa."

#: auth_kit/passwordless/passwordless_api_descriptions.py:63
#, python-brace-format
msgid ""
"Complete passwordless authentication via {}. Verify the credential/token "
"from the initiate step."
msgstr ""
"Whakamua i te whakamotuhēhēnga kore kupuhipa ma {}. Manatoko i te "
"tohu/raihana mai i te hikoinga timata."

#: auth_kit/passwordless/serializers/email_link.py:98
msgid "Invalid or expired token."
msgstr "He hee ranei kua pau te tohu."

#: auth_kit/passwordless/serializers/login.py:93
msgid "User account is disabled."
msgstr "Kua monokia te kaute kaiwhakamahi."

#: auth_kit/passwordless/serializers/webauthn.py:44
msgid ""
"Optional email for non-discoverable credential flow. Omit for passkey "
"(discoverable) flow."
msgstr ""
"Imeera tūāhukahuka mo te rere raihana kore kitea. Wehe atu mo te rere "
"passkey (kitea)."

#: auth_kit/passwordless/serializers/webauthn.py:91
msgid "WebAuthn authentication failed."
msgstr "I hinga te whakamotuhēhēnga WebAuthn."

#: auth_kit/serializers/jwt.py:33
msgid "Will override cookie."
msgstr "Ka whakaaro ki te kuki."

#: auth_kit/serializers/jwt.py:71
msgid "No valid refresh token found."
msgstr "Kaore he tohu whakahou whakawhitiwhiti i kitea."

#: auth_kit/serializers/login_factors.py:125
msgid "E-mail is not verified."
msgstr "Kaore te īmēra i whakamanatia."

#: auth_kit/serializers/login_factors.py:154
msgid ""
"Account locked due to too many failed login attempts. Please try again "
"later."
msgstr ""
"Kua rakaina te kaute na te nui o nga ngana takiuru i hinga. Ngana anō a muri"
" ake."

#: auth_kit/serializers/login_factors.py:158
msgid "Unable to log in with provided credentials."
msgstr "Kaore e taea te takiuru me nga tohu whakarato."

#: auth_kit/serializers/password.py:137 auth_kit/serializers/password.py:140
msgid "Invalid value"
msgstr "Uara muhu"

#: auth_kit/serializers/password.py:222
msgid "Your old password was entered incorrectly. Please enter it again."
msgstr "Ko to kupuhuna tawhito i whakaurua he. Koa whakaurua anō."

#: auth_kit/serializers/registration.py:99
msgid "A user is already registered with this e-mail address."
msgstr "Kua rēhita he kaiwhakamahi me tenei wāhitau īmēra."

#: auth_kit/serializers/registration.py:130
msgid "The two password fields didn't match."
msgstr "Kaore nga āpure kupuhuna e rua i rite."

#: auth_kit/social/serializers/connect.py:55
msgid "Social account email must match your current account email."
msgstr "Me rite te īmēra pūkete pāpori ki to īmēra pūkete o nāianei."

#: auth_kit/social/serializers/connect.py:98
msgid "Connected"
msgstr "Honoa"

#: auth_kit/social/serializers/login.py:88
msgid "Failed to complete OAuth flow"
msgstr "I rahua te whakaoti rere OAuth"

#: auth_kit/social/serializers/login.py:195
msgid "User is already registered with this e-mail address."
msgstr "Kua rēhita te kaiwhakamahi me tenei wāhitau īmēra."

#: auth_kit/social/serializers/login.py:361
msgid "Failed to exchange code for access token"
msgstr "I rahua te whakawhiti waehere mo te tohu urunga"

#: auth_kit/social/social_api_descriptions.py:30
#, python-brace-format
msgid ""
"Authenticate with {} using OAuth2/OpenID Connect authorization code to "
"obtain access tokens."
msgstr ""
"Whakamanatia me {} ma te waehere whakamana OAuth2/OpenID Connect hoki nga "
"tohu urunga."

#: auth_kit/social/social_api_descriptions.py:55
#, python-brace-format
msgid ""
"Connect a {} account to the current user's account. This allows the user to "
"login using their existing {} account in the future."
msgstr ""
"Honoa he pūkete {} ki te pūkete o te kaiwhakamahi o nāianei. Tenei "
"whakaaetanga te kaiwhakamahi takiuru ma to rātou pūkete {} o mua i nga rā o "
"mua."

#: auth_kit/social/social_api_descriptions.py:64
#, python-brace-format
msgid ""
"Requires authentication and a valid OAuth2/OpenID Connect authorization code"
" from {}."
msgstr ""
"Me whakamanatia me he waehere whakamana OAuth2/OpenID Connect "
"whakawhitiwhiti i {}."

#: auth_kit/social/social_api_descriptions.py:70
#, python-brace-format
msgid ""
"On success, the {} account is linked and can be used for future logins."
msgstr ""
"I te angitū, ka honoa te pūkete {} ā ka taea te whakamahi mō nga takiuru a "
"mua."

#: auth_kit/social/social_api_descriptions.py:94
msgid ""
"List all social accounts connected to the current user. Shows account "
"details including provider, UID, and connection dates."
msgstr ""
"Raina nga pūkete pāpori katoa kua honoa ki te kaiwhakamahi o nāianei. "
"Whakaatu nga taipitopito pūkete me te kaiwhakamahi, UID, me nga rā hononga."

#: auth_kit/social/social_api_descriptions.py:99
msgid ""
"Disconnect a social account from the current user. Removes the social "
"account connection and prevents future logins via that provider. Requires "
"authentication and the account must belong to the current user."
msgstr ""
"Wetekina he pūkete pāpori i te kaiwhakamahi o nāianei. Tangohia te hononga "
"pūkete pāpori me te aukati nga takiuru a mua ma taua kaiwhakamahi. Me "
"whakamanatia me no te kaiwhakamahi o nāianei te pūkete."

