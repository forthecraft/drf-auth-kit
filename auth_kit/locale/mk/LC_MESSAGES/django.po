msgstr "корисник"

#: auth_kit/mfa/models.py:171
msgid "User who owns this MFA method"
msgstr "Корисник кој ја поседува оваа MFA метода"

#: auth_kit/mfa/models.py:174 auth_kit/webauthn/models/credential.py:171
msgid "name"
msgstr "име"

#: auth_kit/mfa/models.py:176
msgid "MFA method name (e.g., 'app', 'email')"
msgstr "Име на MFA метода (на пример, 'app', 'email')"

#: auth_kit/mfa/models.py:179
msgid "secret"
msgstr "тајна"

#: auth_kit/mfa/models.py:181
msgid "TOTP secret key for generating verification codes"
msgstr "TOTP таен клуч за генерирање кодови за верификација"

#: auth_kit/mfa/models.py:184
msgid "is primary"
msgstr "е примарна"

#: auth_kit/mfa/models.py:186
msgid "Whether this is the user's primary MFA method"
msgstr "Дали ова е примарната MFA метода на корисникот"

#: auth_kit/mfa/models.py:189
msgid "is active"
msgstr "е активна"

#: auth_kit/mfa/models.py:191
msgid "Whether this method is active and can be used"
msgstr "Дали оваа метода е активна и може да се користи"

#: auth_kit/mfa/models.py:194
msgid "backup codes"
msgstr "резервни кодови"

#: auth_kit/mfa/models.py:197
msgid "JSON field storing backup codes for account recovery"
msgstr "JSON поле кое ги чува резервните кодови за опоравување на сметка"

#: auth_kit/mfa/models.py:203
msgid "MFA Method"
msgstr "MFA Метода"

#: auth_kit/mfa/models.py:204
msgid "MFA Methods"
msgstr "MFA Методи"

