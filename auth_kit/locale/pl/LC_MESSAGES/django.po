msgstr "Usunięto metodę MFA"

#: auth_kit/mfa/serializers/mfa.py:392
msgid "MFA code sent"
msgstr "Kod MFA wysłany"

#: auth_kit/passwordless/handlers/email_link.py:43
msgid "Email Magic Link"
msgstr "Magiczny link e-mail"

#: auth_kit/passwordless/handlers/email_link.py:82
#: auth_kit/passwordless/handlers/email_link.py:115
msgid "A login link has been sent."
msgstr "Link do logowania został wysłany."

#: auth_kit/passwordless/handlers/webauthn.py:39
msgid "Passkey / Security Key"
msgstr "Klucz dostępu / Klucz bezpieczeństwa"

#: auth_kit/passwordless/passwordless_api_descriptions.py:42
#, python-brace-format
msgid ""
"Initiate passwordless authentication via {}. This is the first step of the "
"passwordless login flow."
msgstr ""
"Zainicjuj uwierzytelnianie bez hasła przez {}. Jest to pierwszy krok procesu"
" logowania bez hasła."

#: auth_kit/passwordless/passwordless_api_descriptions.py:63
#, python-brace-format
msgid ""
"Complete passwordless authentication via {}. Verify the credential/token "
"from the initiate step."
msgstr ""
"Ukończ uwierzytelnianie bez hasła przez {}. Zweryfikuj poświadczenie/token z"
" kroku inicjowania."

#: auth_kit/passwordless/serializers/email_link.py:98
msgid "Invalid or expired token."
msgstr "Nieprawidłowy lub wygasły token."

#: auth_kit/passwordless/serializers/login.py:93
msgid "User account is disabled."
msgstr "Konto użytkownika jest wyłączone."

#: auth_kit/passwordless/serializers/webauthn.py:44
msgid ""
"Optional email for non-discoverable credential flow. Omit for passkey "
"(discoverable) flow."
msgstr ""
"Opcjonalny adres e-mail dla przepływu nieodkrywalnych poświadczeń. Pomiń w "
"przypadku przepływu klucza dostępu (odkrywalnego)."

#: auth_kit/passwordless/serializers/webauthn.py:91
msgid "WebAuthn authentication failed."
msgstr "Uwierzytelnianie WebAuthn nie powiodło się."

#: auth_kit/serializers/jwt.py:33
msgid "Will override cookie."
msgstr "Zastąpi plik cookie."

#: auth_kit/serializers/jwt.py:71
msgid "No valid refresh token found."
msgstr "Nie znaleziono ważnego tokenu odświeżania."

#: auth_kit/serializers/login_factors.py:125
msgid "E-mail is not verified."
msgstr "E-mail nie jest zweryfikowany."

#: auth_kit/serializers/login_factors.py:154
msgid ""
"Account locked due to too many failed login attempts. Please try again "
"later."
msgstr ""
"Konto zostało zablokowane z powodu zbyt wielu nieudanych prób logowania. "
"Spróbuj ponownie później."

#: auth_kit/serializers/login_factors.py:158
msgid "Unable to log in with provided credentials."
msgstr ""
"Nie można zalogować się przy użyciu podanych danych uwierzytelniających."

#: auth_kit/serializers/password.py:137 auth_kit/serializers/password.py:140
msgid "Invalid value"
msgstr "Nieprawidłowa wartość"

#: auth_kit/serializers/password.py:222
msgid "Your old password was entered incorrectly. Please enter it again."
msgstr ""
"Twoje stare hasło zostało wprowadzone nieprawidłowo. Proszę wprowadź je "
"ponownie."

#: auth_kit/serializers/registration.py:99
msgid "A user is already registered with this e-mail address."
msgstr "Użytkownik z tym adresem e-mail jest już zarejestrowany."

#: auth_kit/serializers/registration.py:130
msgid "The two password fields didn't match."
msgstr "Dwa pola hasła nie pasują do siebie."

#: auth_kit/social/serializers/connect.py:55
msgid "Social account email must match your current account email."
msgstr ""
"E-mail konta społecznościowego musi pasować do e-maila Twojego bieżącego "
"konta."

#: auth_kit/social/serializers/connect.py:98
msgid "Connected"
msgstr "Połączono"

#: auth_kit/social/serializers/login.py:88
msgid "Failed to complete OAuth flow"
msgstr "Nie udało się ukończyć przepływu OAuth"

#: auth_kit/social/serializers/login.py:195
msgid "User is already registered with this e-mail address."
msgstr "Użytkownik z tym adresem e-mail jest już zarejestrowany."

#: auth_kit/social/serializers/login.py:361
msgid "Failed to exchange code for access token"
msgstr "Nie udało się wymienić kodu na token dostępu"

#: auth_kit/social/social_api_descriptions.py:30
#, python-brace-format
msgid ""
"Authenticate with {} using OAuth2/OpenID Connect authorization code to "
"obtain access tokens."
msgstr ""
"Uwierzytelnij się z {} przy użyciu kodu autoryzacji OAuth2/OpenID Connect, "
"aby uzyskać tokeny dostępu."

#: auth_kit/social/social_api_descriptions.py:55
#, python-brace-format
msgid ""
"Connect a {} account to the current user's account. This allows the user to "
"login using their existing {} account in the future."
msgstr ""
"Połącz konto {} z kontem bieżącego użytkownika. Pozwala to użytkownikowi na "
"logowanie przy użyciu istniejącego konta {} w przyszłości."

#: auth_kit/social/social_api_descriptions.py:64
#, python-brace-format
msgid ""
"Requires authentication and a valid OAuth2/OpenID Connect authorization code"
" from {}."
msgstr ""
"Wymaga uwierzytelnienia i ważnego kodu autoryzacji OAuth2/OpenID Connect z "
"{}."

#: auth_kit/social/social_api_descriptions.py:70
#, python-brace-format
msgid ""
"On success, the {} account is linked and can be used for future logins."
msgstr ""
"Po sukcesie konto {} jest połączone i może być używane do przyszłych "
"logowań."

#: auth_kit/social/social_api_descriptions.py:94
msgid ""
"List all social accounts connected to the current user. Shows account "
"details including provider, UID, and connection dates."
msgstr ""
"Wyświetl wszystkie konta społecznościowe połączone z bieżącym użytkownikiem."
" Pokazuje szczegóły konta, w tym dostawcę, UID i daty połączenia."

#: auth_kit/social/social_api_descriptions.py:99
msgid ""
"Disconnect a social account from the current user. Removes the social "
"account connection and prevents future logins via that provider. Requires "
"authentication and the account must belong to the current user."
msgstr ""
"Odłącz konto społecznościowe od bieżącego użytkownika. Usuwa połączenie "
"konta społecznościowego i zapobiega przyszłym logowaniom przez tego "
"dostawcę. Wymaga uwierzytelnienia i konto musi należeć do bieżącego "
"użytkownika."

