#: auth_kit/api_descriptions.py:29
msgid ""
"Returns user details along with JWT access and refresh tokens with "
"expiration times."
msgstr ""
"Zwraca szczegóły użytkownika wraz z tokenami dostępu i odświeżania JWT z "
"czasami wygaśnięcia."

#: auth_kit/api_descriptions.py:33
msgid ""
"Returns user details along with a DRF authentication token for API access."
msgstr ""
"Zwraca szczegóły użytkownika wraz z tokenem uwierzytelniania DRF do dostępu "
"API."

#: auth_kit/api_descriptions.py:36
msgid "Returns user details along with custom authentication tokens."
msgstr ""
"Zwraca szczegóły użytkownika wraz z niestandardowymi tokenami "
"uwierzytelniania."

#: auth_kit/api_descriptions.py:42
msgid "JWT access and refresh tokens"
msgstr "Tokeny dostępu i odświeżania JWT"

#: auth_kit/api_descriptions.py:44
msgid "DRF authentication token"
msgstr "Token uwierzytelniania DRF"

#: auth_kit/api_descriptions.py:46
msgid "custom authentication tokens"
msgstr "niestandardowe tokeny uwierzytelniania"

#: auth_kit/api_descriptions.py:53
msgid "Authentication cookies are set automatically for secure token storage."
msgstr ""
"Pliki cookie uwierzytelniania są ustawiane automatycznie dla bezpiecznego "
"przechowywania tokenów."

#: auth_kit/api_descriptions.py:61
msgid "Blacklists JWT refresh tokens to prevent further use."
msgstr ""
"Dodaje tokeny odświeżania JWT do czarnej listy, aby zapobiec dalszemu "
"użyciu."

#: auth_kit/api_descriptions.py:63
msgid "Deletes the DRF authentication token from the database."
msgstr "Usuwa token uwierzytelniania DRF z bazy danych."

#: auth_kit/api_descriptions.py:65
msgid "Invalidates custom authentication tokens."
msgstr "Unieważnia niestandardowe tokeny uwierzytelniania."

#: auth_kit/api_descriptions.py:71
msgid "Clears authentication cookies from the browser."
msgstr "Czyści pliki cookie uwierzytelniania z przeglądarki."

#: auth_kit/api_descriptions.py:77
msgid "Authenticate with username/email and password to obtain access tokens."
msgstr ""
"Uwierzytelnij się nazwą użytkownika/e-mailem i hasłem, aby uzyskać tokeny "
"dostępu."

#: auth_kit/api_descriptions.py:89
msgid "Logout user and invalidate authentication tokens."
msgstr "Wyloguj użytkownika i unieważnij tokeny uwierzytelniania."

#: auth_kit/api_descriptions.py:93
msgid ""
"Requires authentication to ensure only valid sessions can be logged out."
msgstr ""
"Wymaga uwierzytelnienia, aby zapewnić, że tylko ważne sesje mogą zostać "
"wylogowane."

#: auth_kit/api_descriptions.py:104
msgid "Generate new JWT access tokens using refresh tokens."
msgstr "Generuj nowe tokeny dostępu JWT przy użyciu tokenów odświeżania."

#: auth_kit/api_descriptions.py:108
msgid ""
"Refresh tokens can be provided in request data or extracted automatically "
"from HTTP cookies."
msgstr ""
"Tokeny odświeżania mogą być dostarczane w danych żądania lub automatycznie "
"wyodrębniane z plików cookie HTTP."

#: auth_kit/api_descriptions.py:110 auth_kit/api_descriptions.py:120
msgid "Returns new access tokens with updated expiration times."
msgstr "Zwraca nowe tokeny dostępu z zaktualizowanymi czasami wygaśnięcia."

#: auth_kit/api_descriptions.py:112
msgid "New tokens are automatically set in HTTP cookies for secure storage."
msgstr ""
"Nowe tokeny są automatycznie ustawiane w plikach cookie HTTP dla "
"bezpiecznego przechowywania."

#: auth_kit/api_descriptions.py:119
msgid "Refresh tokens must be provided in the request data."
msgstr "Tokeny odświeżania muszą być dostarczone w danych żądania."

#: auth_kit/api_descriptions.py:127
msgid "Register a new user account."
msgstr "Zarejestruj nowe konto użytkownika."

#: auth_kit/api_descriptions.py:134
msgid ""
"Users must verify their email address before the account is fully activated."
msgstr ""
"Użytkownicy muszą zweryfikować swój adres e-mail przed pełną aktywacją "
"konta."

#: auth_kit/api_descriptions.py:143
msgid ""
"Send password reset instructions to the provided email address. If the email"
" is registered, a secure reset link will be sent. The link expires after a "
"limited time for security."
msgstr ""
"Wyślij instrukcje resetowania hasła na podany adres e-mail. Jeśli e-mail "
"jest zarejestrowany, zostanie wysłany bezpieczny link resetowania. Link "
"wygasa po ograniczonym czasie ze względów bezpieczeństwa."

#: auth_kit/api_descriptions.py:149
msgid ""
"Complete the password reset process using the token from the reset email. "
"Requires the UID and token from the email along with the new password. The "
"token is single-use and expires for security."
msgstr ""
"Zakończ proces resetowania hasła przy użyciu tokenu z e-maila resetowania. "
"Wymaga UID i tokenu z e-maila wraz z nowym hasłem. Token jest jednorazowy i "
"wygasa ze względów bezpieczeństwa."

#: auth_kit/api_descriptions.py:155
msgid "Change the current user's password. Requires authentication. "
msgstr "Zmień hasło bieżącego użytkownika. Wymaga uwierzytelnienia. "

#: auth_kit/api_descriptions.py:159
msgid ""
"Confirm email address using the verification key sent via email. This "
"activates the user account and allows login access."
msgstr ""
"Potwierdź adres e-mail używając klucza weryfikacyjnego wysłanego e-mailem. "
"To aktywuje konto użytkownika i umożliwia dostęp do logowania."

#: auth_kit/api_descriptions.py:164
msgid ""
"Send a new email verification message to unverified email addresses. Only "
"works for email addresses that are registered but not yet verified."
msgstr ""
"Wyślij nową wiadomość weryfikacji e-mail na niezweryfikowane adresy e-mail. "
"Działa tylko dla adresów e-mail, które są zarejestrowane, ale jeszcze nie "
"zweryfikowane."

#: auth_kit/api_descriptions.py:169
msgid ""
"Retrieve the authenticated user's profile information including username, "
"email, first name, and last name. Password fields are excluded."
msgstr ""
"Pobierz informacje o profilu uwierzytelnionego użytkownika, w tym nazwę "
"użytkownika, e-mail, imię i nazwisko. Pola hasła są wykluczone."

#: auth_kit/api_descriptions.py:174
msgid ""
"Update the authenticated user's profile information. Allows modification of "
"username, first name, and last name. Email field is read-only for security."
msgstr ""
"Zaktualizuj informacje o profilu uwierzytelnionego użytkownika. Umożliwia "
"modyfikację nazwy użytkownika, imienia i nazwiska. Pole e-mail jest tylko do"
" odczytu ze względów bezpieczeństwa."

#: auth_kit/api_descriptions.py:180
msgid ""
"Partially update the authenticated user's profile information. Only provided"
" fields will be updated. Email field is read-only."
msgstr ""
"Częściowo zaktualizuj informacje o profilu uwierzytelnionego użytkownika. "
"Tylko dostarczone pola zostaną zaktualizowane. Pole e-mail jest tylko do "
"odczytu."

#: auth_kit/forms.py:111
msgid "The email address is not assigned to any user account."
msgstr "Adres e-mail nie jest przypisany do żadnego konta użytkownika."

#: auth_kit/mfa/exceptions.py:27
msgid "Requested MFA method does not exist."
msgstr "Żądana metoda MFA nie istnieje."

#: auth_kit/mfa/handlers/email.py:29
msgid "Email message with MFA code has been sent."
msgstr "Wiadomość e-mail z kodem MFA została wysłana."

#: auth_kit/mfa/handlers/webauthn.py:39
msgid "Registration options for navigator.credentials.create()"
msgstr "Opcje rejestracji dla navigator.credentials.create()"

#: auth_kit/mfa/handlers/webauthn.py:57
msgid "Security Key / Passkey"
msgstr "Klucz bezpieczeństwa / Klucz dostępu"

#: auth_kit/mfa/mfa_api_descriptions.py:29
#, python-brace-format
msgid "MFA code expires in {} seconds."
msgstr "Kod MFA wygasa za {} sekund."

#: auth_kit/mfa/mfa_api_descriptions.py:37
msgid ""
"First step of MFA-enabled authentication. Validates credentials and "
"initiates MFA flow."
msgstr ""
"Pierwszy krok uwierzytelniania z włączonym MFA. Sprawdza dane "
"uwierzytelniające i inicjuje przepływ MFA."

#: auth_kit/mfa/mfa_api_descriptions.py:42
#, python-brace-format
msgid ""
"Returns ephemeral token for MFA verification or complete {} if MFA is "
"disabled."
msgstr ""
"Zwraca token tymczasowy do weryfikacji MFA lub kompletne {}, jeśli MFA jest "
"wyłączone."

#: auth_kit/mfa/mfa_api_descriptions.py:54
msgid ""
"Complete MFA authentication using verification code and ephemeral token."
msgstr ""
"Zakończ uwierzytelnianie MFA przy użyciu kodu weryfikacyjnego i tokenu "
"tymczasowego."

#: auth_kit/mfa/mfa_api_descriptions.py:59
msgid "Supports both TOTP codes and backup codes for verification."
msgstr "Obsługuje zarówno kody TOTP, jak i kody zapasowe do weryfikacji."

#: auth_kit/mfa/mfa_api_descriptions.py:71
msgid "Switch to a different MFA method during authentication flow."
msgstr "Przełącz na inną metodę MFA podczas przepływu uwierzytelniania."

#: auth_kit/mfa/mfa_api_descriptions.py:73
msgid "Requires valid ephemeral token from first step authentication."
msgstr ""
"Wymaga ważnego tokenu tymczasowego z pierwszego kroku uwierzytelniania."

#: auth_kit/mfa/mfa_api_descriptions.py:76
#: auth_kit/mfa/mfa_api_descriptions.py:92
#, python-brace-format
msgid "New ephemeral token expires in {} seconds."
msgstr "Nowy token tymczasowy wygasa za {} sekund."

#: auth_kit/mfa/mfa_api_descriptions.py:85
msgid "Resend MFA verification code using existing ephemeral token."
msgstr ""
"Wyślij ponownie kod weryfikacji MFA przy użyciu istniejącego tokenu "
"tymczasowego."

#: auth_kit/mfa/mfa_api_descriptions.py:88
msgid "Only applicable for methods that require code dispatch (e.g., email)."
msgstr "Dotyczy tylko metod wymagających wysyłania kodu (np. e-mail)."

#: auth_kit/mfa/mfa_api_descriptions.py:102
msgid ""
"Get a login challenge for the pending MFA method using an existing ephemeral"
" token."
msgstr ""
"Pobierz wyzwanie logowania dla oczekującej metody MFA przy użyciu "
"istniejącego tymczasowego tokena."

#: auth_kit/mfa/mfa_api_descriptions.py:107
msgid ""
"Only applicable for challenge-response methods (e.g., passkeys). Other "
"methods return an empty object."
msgstr ""
"Dotyczy tylko metod wyzwanie-odpowiedź (np. kluczy dostępu). Inne metody "
"zwracają pusty obiekt."

#: auth_kit/mfa/mfa_api_descriptions.py:116
msgid ""
"List all available MFA methods with their setup and activation status. Shows"
" which methods are configured, active, and set as primary."
msgstr ""
"Wyświetl wszystkie dostępne metody MFA z ich statusem konfiguracji i "
"aktywacji. Pokazuje które metody są skonfigurowane, aktywne i ustawione jako"
" główne."

#: auth_kit/mfa/mfa_api_descriptions.py:121
msgid ""
"Initialize a new MFA method setup. Creates the method with backup codes and "
"returns setup instructions (e.g., QR code for authenticator apps). Method "
"must be confirmed before activation."
msgstr ""
"Zainicjuj konfigurację nowej metody MFA. Tworzy metodę z kodami zapasowymi i"
" zwraca instrukcje konfiguracji (np. kod QR dla aplikacji "
"uwierzytelniających). Metoda musi być potwierdzona przed aktywacją."

#: auth_kit/mfa/mfa_api_descriptions.py:127
msgid ""
"Confirm and activate a newly created MFA method using verification code. "
"Automatically sets as primary method if no other primary method exists. "
"Required before the method can be used for authentication."
msgstr ""
"Potwierdź i aktywuj nowo utworzoną metodę MFA przy użyciu kodu "
"weryfikacyjnego. Automatycznie ustawia jako metodę główną, jeśli nie "
"istnieje inna metoda główna. Wymagane przed użyciem metody do "
"uwierzytelniania."

#: auth_kit/mfa/mfa_api_descriptions.py:133
msgid ""
"Deactivate an active MFA method. Requires verification code from the method "
"itself. Cannot deactivate primary methods - set another method as primary "
"first."
msgstr ""
"Dezaktywuj aktywną metodę MFA. Wymaga kodu weryfikacyjnego z samej metody. "
"Nie można dezaktywować metod głównych - najpierw ustaw inną metodę jako "
"główną."

#: auth_kit/mfa/mfa_api_descriptions.py:141
msgid ""
"Set an active MFA method as the primary authentication method. Primary "
"method is used by default during login flow."
msgstr ""
"Ustaw aktywną metodę MFA jako główną metodę uwierzytelniania. Metoda główna "
"jest używana domyślnie podczas przepływu logowania."

#: auth_kit/mfa/mfa_api_descriptions.py:145
msgid "Only one method can be primary at a time."
msgstr "Tylko jedna metoda może być główna w danym czasie."

#: auth_kit/mfa/mfa_api_descriptions.py:148
msgid "Requires verification code from current primary method."
msgstr "Wymaga kodu weryfikacyjnego z bieżącej metody głównej."

#: auth_kit/mfa/mfa_api_descriptions.py:155
msgid ""
"Send verification code for methods that support code dispatch. Useful for "
"testing method configuration or manual code requests."
msgstr ""
"Wyślij kod weryfikacyjny dla metod obsługujących wysyłanie kodu. Przydatne "
"do testowania konfiguracji metody lub ręcznych żądań kodu."

#: auth_kit/mfa/mfa_api_descriptions.py:162
msgid "Permanently delete an MFA method."
msgstr "Trwale usuń metodę MFA."

#: auth_kit/mfa/mfa_api_descriptions.py:163
msgid "This action cannot be undone."
msgstr "Ta akcja nie może zostać cofnięta."

#: auth_kit/mfa/mfa_api_descriptions.py:168
msgid "Cannot delete active methods."
msgstr "Nie można usunąć aktywnych metod."

#: auth_kit/mfa/mfa_api_descriptions.py:171
msgid "Cannot delete primary methods."
msgstr "Nie można usunąć metod głównych."

#: auth_kit/mfa/mfa_api_descriptions.py:174
msgid "Requires verification code for active methods."
msgstr "Wymaga kodu weryfikacyjnego dla aktywnych metod."

