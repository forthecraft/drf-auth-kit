msgstr "códigos de backup"

#: auth_kit/mfa/models.py:253
msgid "JSON field storing backup codes for account recovery"
msgstr "Campo JSON que armazena códigos de backup para recuperação de conta"

#: auth_kit/mfa/models.py:259
msgid "MFA Method"
msgstr "Método MFA"

#: auth_kit/mfa/models.py:260
msgid "MFA Methods"
msgstr "Métodos MFA"

