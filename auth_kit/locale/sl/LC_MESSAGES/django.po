msgstr "JSON polje, ki shranjuje rezervne kode za obnovitev računa"

#: auth_kit/mfa/models.py:259
msgid "MFA Method"
msgstr "MFA Metoda"

#: auth_kit/mfa/models.py:260
msgid "MFA Methods"
msgstr "MFA Metode"

