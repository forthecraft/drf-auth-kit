#: auth_kit/mfa/serializers/mfa.py:237 auth_kit/mfa/serializers/mfa.py:381
msgid "Invalid OTP code"
msgstr "Ogiltig OTP-kod"

#: auth_kit/mfa/serializers/mfa.py:246
