#: auth_kit/social/social_api_descriptions.py:30
#, python-brace-format
msgid ""
"Authenticate with {} using OAuth2/OpenID Connect authorization code to "
"obtain access tokens."
msgstr ""
"Thibitisha kwa {} kwa kutumia msimbo wa idhini wa OAuth2/OpenID Connect ili "
"kupata alama za ufikiaji."

#: auth_kit/social/social_api_descriptions.py:55
#, python-brace-format
msgid ""
"Connect a {} account to the current user's account. This allows the user to "
"login using their existing {} account in the future."
msgstr ""
"Unganisha akaunti ya {} na akaunti ya mtumiaji wa sasa. Hii inaruhusu "
"mtumiaji kuingia kwa kutumia akaunti yao ya {} iliyopo katika siku zijazo."

#: auth_kit/social/social_api_descriptions.py:64
#, python-brace-format
msgid ""
"Requires authentication and a valid OAuth2/OpenID Connect authorization code"
" from {}."
msgstr ""
"Inahitaji uthibitishaji na msimbo halali wa idhini wa OAuth2/OpenID Connect "
"kutoka {}."

#: auth_kit/social/social_api_descriptions.py:70
#, python-brace-format
msgid ""
"On success, the {} account is linked and can be used for future logins."
msgstr ""
"Ikiwa imefanikiwa, akaunti ya {} itaunganishwa na inaweza kutumiwa kwa "
"kuingia katika siku zijazo."

#: auth_kit/social/social_api_descriptions.py:94
msgid ""
"List all social accounts connected to the current user. Shows account "
"details including provider, UID, and connection dates."
msgstr ""
"Inaorodhesha akaunti zote za kijamii zilizounganishwa na mtumiaji wa sasa. "
"Inaonyesha maelezo ya akaunti ikijumuisha mtoa huduma, UID, na tarehe za "
"muunganisho."

#: auth_kit/social/social_api_descriptions.py:99
msgid ""
"Disconnect a social account from the current user. Removes the social "
"account connection and prevents future logins via that provider. Requires "
"authentication and the account must belong to the current user."
msgstr ""
"Inakatisha muunganisho wa akaunti ya kijamii kutoka kwa mtumiaji wa sasa. "
"Inaondoa muunganisho wa akaunti ya kijamii na kuzuia kuingia kwa siku zijazo"
" kupitia mtoa huduma huyo. Inahitaji uthibitishaji na akaunti lazima iwe ya "
"mtumiaji wa sasa."

