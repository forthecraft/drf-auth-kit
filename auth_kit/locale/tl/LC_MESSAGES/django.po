#: auth_kit/passwordless/passwordless_api_descriptions.py:42
#, python-brace-format
msgid ""
"Initiate passwordless authentication via {}. This is the first step of the "
"passwordless login flow."
msgstr ""
"Simulan ang passwordless authentication sa pamamagitan ng {}. Ito ang unang "
"hakbang ng passwordless login flow."

#: auth_kit/passwordless/passwordless_api_descriptions.py:63
#, python-brace-format
msgid ""
"Complete passwordless authentication via {}. Verify the credential/token "
"from the initiate step."
msgstr ""
"Kumpletuhin ang passwordless authentication sa pamamagitan ng {}. I-verify "
"ang credential/token mula sa hakbang ng pagsisimula."

#: auth_kit/passwordless/serializers/email_link.py:98
msgid "Invalid or expired token."
msgstr "Hindi wasto o nag-expire na ang token."

#: auth_kit/passwordless/serializers/login.py:93
msgid "User account is disabled."
msgstr "Ang user account ay naka-disable."

#: auth_kit/passwordless/serializers/webauthn.py:44
msgid ""
"Optional email for non-discoverable credential flow. Omit for passkey "
"(discoverable) flow."
msgstr ""
"Opsyonal na email para sa non-discoverable credential flow. Alisin para sa "
"passkey (discoverable) flow."

#: auth_kit/passwordless/serializers/webauthn.py:91
msgid "WebAuthn authentication failed."
msgstr "Nabigo ang WebAuthn authentication."

#: auth_kit/serializers/jwt.py:33
msgid "Will override cookie."
msgstr "Papalitan ang cookie."

#: auth_kit/serializers/jwt.py:71
msgid "No valid refresh token found."
msgstr "Walang valid refresh token na nakita."

#: auth_kit/serializers/login_factors.py:125
msgid "E-mail is not verified."
msgstr "Hindi na-verify ang e-mail."

#: auth_kit/serializers/login_factors.py:154
msgid ""
"Account locked due to too many failed login attempts. Please try again "
"later."
msgstr ""
"Na-lock ang account dahil sa masyadong maraming nabigong pagtatangkang mag-"
"login. Pakisubukan muli sa ibang pagkakataon."

#: auth_kit/serializers/login_factors.py:158
msgid "Unable to log in with provided credentials."
msgstr "Hindi makapag-login gamit ang naibigay na credentials."

#: auth_kit/serializers/password.py:137 auth_kit/serializers/password.py:140
msgid "Invalid value"
msgstr "Invalid value"

#: auth_kit/serializers/password.py:222
msgid "Your old password was entered incorrectly. Please enter it again."
msgstr "Ang inyong lumang password ay mali ang pagkakapasok. Pakiulit po."

#: auth_kit/serializers/registration.py:99
msgid "A user is already registered with this e-mail address."
msgstr "May user na nakarehistro sa e-mail address na ito."

#: auth_kit/serializers/registration.py:130
msgid "The two password fields didn't match."
msgstr "Ang dalawang password fields ay hindi magkatugma."

#: auth_kit/social/serializers/connect.py:55
msgid "Social account email must match your current account email."
msgstr ""
"Ang social account email ay dapat tumugma sa inyong kasalukuyang account "
"email."

#: auth_kit/social/serializers/connect.py:98
msgid "Connected"
msgstr "Nakaconnect"

#: auth_kit/social/serializers/login.py:88
msgid "Failed to complete OAuth flow"
msgstr "Hindi nakumpleto ang OAuth flow"

#: auth_kit/social/serializers/login.py:195
msgid "User is already registered with this e-mail address."
msgstr "Ang user ay nakarehistro na sa e-mail address na ito."

#: auth_kit/social/serializers/login.py:361
msgid "Failed to exchange code for access token"
msgstr "Hindi naging matagumpay ang exchange ng code para sa access token"

#: auth_kit/social/social_api_descriptions.py:30
#, python-brace-format
msgid ""
"Authenticate with {} using OAuth2/OpenID Connect authorization code to "
"obtain access tokens."
msgstr ""
"Mag-authenticate gamit ang {} sa pamamagitan ng OAuth2/OpenID Connect "
"authorization code para makakuha ng access tokens."

#: auth_kit/social/social_api_descriptions.py:55
#, python-brace-format
msgid ""
"Connect a {} account to the current user's account. This allows the user to "
"login using their existing {} account in the future."
msgstr ""
"Mag-connect ng {} account sa kasalukuyang user account. Ito ay nagbibigay-"
"daan sa user na mag-login gamit ang kanilang existing {} account sa "
"hinaharap."

#: auth_kit/social/social_api_descriptions.py:64
#, python-brace-format
msgid ""
"Requires authentication and a valid OAuth2/OpenID Connect authorization code"
" from {}."
msgstr ""
"Kailangan ng authentication at valid OAuth2/OpenID Connect authorization "
"code mula sa {}."

#: auth_kit/social/social_api_descriptions.py:70
#, python-brace-format
msgid ""
"On success, the {} account is linked and can be used for future logins."
msgstr ""
"Kapag matagumpay, ang {} account ay ma-link at maaaring gamitin para sa mga "
"future logins."

#: auth_kit/social/social_api_descriptions.py:94
msgid ""
"List all social accounts connected to the current user. Shows account "
"details including provider, UID, and connection dates."
msgstr ""
"Ilista ang lahat ng social accounts na nakaconnect sa kasalukuyang user. "
"Ipinakita ang account details kasama ang provider, UID, at connection dates."

#: auth_kit/social/social_api_descriptions.py:99
msgid ""
"Disconnect a social account from the current user. Removes the social "
"account connection and prevents future logins via that provider. Requires "
"authentication and the account must belong to the current user."
msgstr ""
"I-disconnect ang social account mula sa kasalukuyang user. Tinatanggal ang "
"social account connection at pinipigilan ang mga future logins sa "
"pamamagitan ng provider na iyon. Kailangan ng authentication at ang account "
"ay dapat pag-aari ng kasalukuyang user."

#: auth_kit/social/views/login.py:58
msgid "adapter_class is not defined"
msgstr "hindi nadefine ang adapter_class"

#: auth_kit/views/logout.py:110
msgid "Refresh token was not included in cookie data."
msgstr "Ang refresh token ay hindi kasama sa cookie data."

#: auth_kit/views/logout.py:120
msgid "Refresh token was not included in request data."
msgstr "Ang refresh token ay hindi kasama sa request data."

#: auth_kit/views/logout.py:131
msgid "An error has occurred."
msgstr "May error na naganap."

#: auth_kit/views/logout.py:148
msgid "Successfully logged out."
msgstr "Matagumpay na nag-logout."

#: auth_kit/views/password.py:64
msgid "Password reset e-mail has been sent."
msgstr "Napadala na ang password reset e-mail."

#: auth_kit/views/password.py:112
msgid "Password has been reset with the new password."
msgstr "Na-reset na ang password gamit ang bagong password."

#: auth_kit/views/password.py:157
msgid "New password has been saved."
msgstr "Na-save na ang bagong password."

